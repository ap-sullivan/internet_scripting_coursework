@page
@{
    ViewData["PageClass"] = "landing-page"; 
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <div class="landing-page">
    <img src="images/chinook_no_bg.png" alt="Chinook Records logo width outline of helicopter and vinyl reocrds" class="landing-page-logo">
    <h1 class="landing-page-title"> Welcome to Chinook Records</h1>


     <a class="btn-primary" id="btn-primary" href="/View">
        View Records
    </a>
 
  


    </div>


        <script>

document.getElementById("btn-primary").addEventListener("click", function () {
   
    let overlay = document.createElement("div");
    overlay.id = "radial-overlay";
    document.body.appendChild(overlay);


    setTimeout(() => {
        overlay.style.transform = "translate(-50%, -50%) scale(2)";
    }, 150);

  
    setTimeout(() => {
        window.location.href = "view.html";
    }, 7000);
});
     
        
        
        </script>

</body>
</html>