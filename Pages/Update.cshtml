@page "/update/{albumId}"
@model project.Pages.UpdateAlbum

@{
    ViewData["Title"] = "Update Record";
}

<div class="page-container">
    
   <div class="update-content-container">


    @if (Model.Album != null)
    {
        <div class="form-container">

  <h1>Update Album</h1>
        <form method="post" class="update-form" onsubmit="return confirm('Are you sure you want to update this record?');">
            @Html.AntiForgeryToken()

            @* hidden fields *@
            <div class="">
                <input type="hidden" name="updtAlbumId" value="@Model.Album!.AlbumId">
            </div>
            <div class="">
                <input type="hidden" name="updtArtistId" value="@Model.Artist!.ArtistId">
            </div>


            <div class="update-form-group">
                <label for="updateTitle" class="update-label">Album Title:</label>
                <input type="text" id="updateTitle" name="updateTitle" value="@Model.Album.Title" class="update-input" required/>
            </div>


            <div class="update-form-group">
                <label for="updateName" class="update-label">Artist Name:</label>
                <input type="text" id="updateName" name="updateName" value="@Model.Artist.Name" class="update-input" required />
            </div>

            @{
                int counter = 1;
            }
            @foreach (var track in Model.Tracks)
            {
                <div class="update-form-group">
                    <label for="TrackName" class="update-label">Track @counter:</label>
                    <input type="text" id="@track.TrackId" name="@track.TrackId" value="@track.Name" class="update-input"/>
                </div>
                counter++;

            }
               <div class="button-container">

            <button type="submit" class="btn-secondary btn-success">Update</button>
               </div> 
        </form>
          
               </div>
    }

  <a href="/View" class="btn-primary btn-back-to-view">Back to View</a>

     </div>

</div>

    <script src="js/script.js"></script>
