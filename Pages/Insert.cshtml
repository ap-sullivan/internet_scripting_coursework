@page
@{
    ViewData["Title"] = "Insert Record";
}
@using ChinookEntities
@model project.Pages.InsertAlbum;

<div class="page-container">


    <form action="~/Insert" method="post">
        @Html.AntiForgeryToken()
        <p>Album Name: <input type="text" name="tbxAlbum"></p>
        <p>Artist Name: <input type="text" name="tbxArtist"></p>
      
     <button id="add-track" type="button">Add Track</button>
    <div id="tracks-container">
        @* <input type="text" placeholder="Track 1" id="tbxTrack1" class="trackInput"> *@
     
    </div>

    
        <p><input type="submit" value="Insert"></p>
    </form>

        
</div>


@* jquery for adding and removing tracks  *@
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    
let trackCounter = 0;


$('#add-track').click(function(event) {
    event.preventDefault();

    trackCounter++;
    

    const track = $('<div class="track">');
    const inputField = $('<input>')
    .attr('type', 'text')
    .attr('placeholder', `Track ${trackCounter}`)
    .attr('name', `tbxTrack${trackCounter}`)
    .attr('id', `tbxTrack${trackCounter}`)
    .attr('class', 'track-input');

    const removeButton = $('<button>').text('Remove');
    
   
    removeButton.click(function() {
        track.remove();
        trackCounter--;
    });
    
    
    track.append(inputField).append(removeButton);
    
    
    $('#tracks-container').append(track);
});

</script>
    
