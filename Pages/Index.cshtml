@page
@using ChinookEntities
@model project.Pages.ViewAlbums;


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chinook</title>
</head>
<body>


  <a href="/Insert">
        Go to Insert Page
</a>

<p>TODO : Add in a quick filter by Artist and genre </p>

    <h1>@Model.Heading</h1>

  <table border="1">
    <thead>
        <tr>
            <th>Album ID</th>
            <th>Title</th>
            <th>Artist</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var albumArtist in Model.AlbumArtists)
        {
            <tr>
                <td>@albumArtist.AlbumId</td>
                <td>@albumArtist.Title</td>
                <td>@albumArtist.Name</td>
            </tr>
        }
    </tbody>
</table>
    
</body>
</html>